<resources>
    <string name="app_name">S23 Enhancer</string>
    <string name="app_subtitle">Systémová, displejová, stavová a foto vylepšení pro Galaxy S23 Ultra</string>
    <string name="footer_note">Změny se projeví po restartu cílové aplikace (nebo SystemUI). Vyžaduje aktivní LSPosed.</string>

    <!-- Sections -->
    <string name="sec_camera">Fotoaparát</string>
    <string name="sec_display">Displej</string>
    <string name="sec_system">Systém</string>

    <!-- Camera -->
    <string name="title_camera_log_video">Log Video</string>
    <string name="desc_camera_log_video">Povolí nativní profil Samsung Log v režimu Pro Video pro maximální dynamický rozsah a barevné úpravy.</string>
    <string name="title_camera_4k60_lenses">Přepínání objektivů ve 4K60</string>
    <string name="desc_camera_4k60_lenses">Umožní přepínat mezi objektivy 0,6x, 1x, 3x a 10x při 4K 60 sn./s bez přechodu na digitální výřez.</string>
    <string name="title_camera_4k120_slowmo">4K120 zpomalené video</string>
    <string name="desc_camera_4k120_slowmo">Odemkne rozlišení 3840x2160 při 120 sn./s v režimu Zpomalený záběr (skrytá položka tabulky rozlišení).</string>
    <string name="title_camera_jpeg_100">100% kvalita JPEG</string>
    <string name="title_camera_shutter_mute">Ztlumení zvuku závěrky</string>
    <string name="title_camera_skip_postproc">Přeskočit post-procesing</string>
    <string name="desc_camera_skip_postproc">Odemkne přepínač Přeskočit post-procesing přímo v Nastavení fotoaparátu (pouze statické fotky; video není ovlivněno). Pokud je zde vypnuto, přepínač se skryje a do post-procesingu se nezasahuje.</string>
    <string name="desc_camera_shutter_mute">Umožní vypnout zvuk závěrky fotoaparátu i v regionech vynucených zámkem CSC. Přidá přepínač Zvuk závěrky do nastavení Fotoaparátu.</string>
    <string name="desc_camera_jpeg_100">Ukládá fotografie JPEG ve 100% kvalitě a vypíná dodatečnou rekompresi.</string>

    <!-- Display -->
    <string name="title_display_outdoor">Venkovní režim</string>
    <string name="desc_display_outdoor">Odemkne přepínač Venkovního režimu v Nastavení &gt; Displej (lze jej přepínat tam nebo přes dlaždici Rychlých nastavení).</string>
    <string name="title_display_screen_mode">Profily displeje</string>
    <string name="desc_display_screen_mode">Odemkne režimy obrazovky AMOLED Kino (DCI-P3) a AMOLED Fotografie (Adobe RGB).</string>
    <string name="row_active_profile">Aktivní profil</string>
    <string name="title_display_screen_timeout">Rozšířené časové limity obrazovky</string>
    <string name="desc_display_screen_timeout">Odemkne možnosti 30 minut, 1 hodina a Nikdy v nastavení Časový limit obrazovky.</string>
    <string name="row_screen_timeout">Časový limit obrazovky</string>
    <string name="title_display_action_timeout">Čas k provedení akce</string>
    <string name="desc_display_action_timeout">Určuje, jak dlouho systém čeká na potvrzení u výzev přístupnosti.</string>
    <string name="row_action_timeout">Limit pro akci</string>
    <string name="title_display_ead">Adaptivní barevný tón (EAD)</string>
    <string name="desc_display_ead">Vynutí podporu Adaptivního barevného tónu v nastavení Displeje.</string>
    <string name="title_display_fonts">Odemknout vlastní písma</string>
    <string name="desc_display_fonts">Umožní instalovat a používat vlastní systémová písma bez kontroly podpisu.</string>

    <!-- System -->
    <string name="title_call_recording">Nahrávání hovorů</string>
    <string name="desc_call_recording">Povolí nativní tlačítko nahrávání hovorů v aplikaci Telefon Samsung.</string>
    <string name="title_wifi_passwords">Zobrazit hesla k Wi-Fi</string>
    <string name="desc_wifi_passwords">Zobrazí uložená hesla Wi-Fi jako prostý text bez nutnosti ověření zámkem obrazovky.</string>
    <string name="title_flag_secure">Obejít omezení snímků obrazovky</string>
    <string name="desc_flag_secure">Umožní pořizovat snímky a záznamy obrazovky v aplikacích chráněných příznakem FLAG_SECURE.</string>
    <string name="title_telemetry">Zakázat telemetrii</string>
    <string name="desc_telemetry">Zastaví odesílání záznamů o pádech a diagnostických hlášení systému.</string>
    <string name="title_app_info_details">Název balíčku a datum instalace v Informacích o aplikaci</string>
    <string name="desc_app_info_details">Zobrazí název balíčku (klepnutím zkopírujete) a datum instalace/aktualizace v Nastavení &gt; Aplikace &gt; Informace o aplikaci.</string>
    <string name="title_fp_improve_accuracy">Zlepšit přesnost otisku prstu</string>
    <string name="desc_fp_improve_accuracy">Odemkne možnost Zlepšit přesnost v Nastavení &gt; Zabezpečení a soukromí &gt; Otisky prstů (10 dodatečných skenů pro lepší rozpoznání přes ochranné sklo).</string>

