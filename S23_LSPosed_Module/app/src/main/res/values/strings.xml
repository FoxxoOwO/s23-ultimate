<resources>
    <string name="app_name">S23 Enhancer</string>
    <string name="app_subtitle">System, display, status bar &amp; camera tweaks for Galaxy S23 Ultra</string>
    <string name="footer_note">Changes take effect after restarting the target app (or SystemUI). Requires active LSPosed.</string>

    <!-- Sections -->
    <string name="sec_camera">Camera</string>
    <string name="sec_display">Display</string>
    <string name="sec_system">System</string>

    <!-- Camera -->
    <string name="title_camera_log_video">Log Video</string>
    <string name="desc_camera_log_video">Enables native Samsung Log profile in Pro Video mode for maximum dynamic range and color grading.</string>
    <string name="title_camera_4k60_lenses">4K60 Lens Switching</string>
    <string name="desc_camera_4k60_lenses">Allows switching between 0.6x, 1x, 3x, and 10x lenses at 4K 60 fps without digital crop fallback.</string>
    <string name="title_camera_4k120_slowmo">4K120 Slow Motion</string>
    <string name="desc_camera_4k120_slowmo">Unlocks 3840x2160 at 120 fps in Slow Motion mode (hidden resolution map entry).</string>
    <string name="title_camera_jpeg_100">100% JPEG Quality</string>
    <string name="title_camera_shutter_mute">Shutter Sound Mute</string>
    <string name="desc_camera_shutter_mute">Allows muting the camera shutter sound even in regions enforced by CSC lock. Adds the Shutter sound toggle in Camera settings.</string>
    <string name="desc_camera_jpeg_100">Saves JPEG photos at 100% quality and disables extra recompression.</string>

    <!-- Display -->
    <string name="title_display_outdoor">Outdoor Mode</string>
    <string name="desc_display_outdoor">Unlocks the Outdoor mode toggle in Settings &gt; Display (toggle it there or via the Quick Settings tile).</string>
    <string name="title_display_screen_mode">Display Profiles</string>
    <string name="desc_display_screen_mode">Unlocks AMOLED Cinema (DCI-P3) and AMOLED Photo (Adobe RGB) screen modes.</string>
    <string name="row_active_profile">Active profile</string>
    <string name="title_display_screen_timeout">Extended Screen Timeouts</string>
    <string name="desc_display_screen_timeout">Unlocks 30 minutes, 1 hour, and Never options in Screen timeout.</string>
    <string name="row_screen_timeout">Screen timeout</string>
    <string name="title_display_action_timeout">Time to Take Action</string>
    <string name="desc_display_action_timeout">Sets how long the system waits for confirmation on accessibility action prompts.</string>
    <string name="row_action_timeout">Action timeout</string>
    <string name="title_display_ead">Adaptive Color Tone (EAD)</string>
    <string name="desc_display_ead">Forces Adaptive Color Tone support in Display settings.</string>
    <string name="title_display_fonts">Unlock Custom Fonts</string>
    <string name="desc_display_fonts">Allows installing and applying custom system fonts without signature checks.</string>

    <!-- System -->
    <string name="title_call_recording">Call Recording</string>
    <string name="desc_call_recording">Enables the native call recording button in the Samsung Phone app.</string>
    <string name="title_wifi_passwords">Show Wi-Fi Passwords</string>
    <string name="desc_wifi_passwords">Displays saved Wi-Fi passwords in plain text without lock screen verification.</string>
    <string name="title_flag_secure">Bypass Screenshot Restriction</string>
    <string name="desc_flag_secure">Allows screenshots and screen recordings in apps protected by FLAG_SECURE.</string>
    <string name="title_telemetry">Disable Telemetry</string>
    <string name="desc_telemetry">Stops crash log uploads and system diagnostic reporting.</string>

