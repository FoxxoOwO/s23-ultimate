<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">S23 Enhancer</string>
    <string name="app_subtitle">Systémové a kamerové úpravy pro Galaxy S23 Ultra</string>
    <string name="footer_note">Změny se projeví po restartu cílové aplikace. Modul vyžaduje aktivní LSPosed.</string>

    <!-- Sekce -->
    <string name="sec_camera">Fotoaparát</string>
    <string name="sec_display">Displej</string>
    <string name="sec_system">Systém</string>

    <!-- Fotoaparát -->
    <string name="title_camera_log_video">Log Video</string>
    <string name="desc_camera_log_video">Aktivuje nativní Log profil v Pro Video pro maximální dynamický rozsah a color grading.</string>
    <string name="title_camera_4k60_lenses">4K60 přepínání objektivů</string>
    <string name="desc_camera_4k60_lenses">Umožňuje přepínání 0,6x, 1x, 3x a 10x objektivu při 4K 60 fps bez digitálního ořezu.</string>
    <string name="title_camera_jpeg_100">100% kvalita</string>
    <string name="title_camera_shutter_mute">Vypnutí zvuku závěrky</string>
    <string name="desc_camera_shutter_mute">Umožní ztlumit zvuk závěrky fotoaparátu i v regionech, kde ho Samsung vynucuje (CSC zámek). Volba Zvuk závěrky se objeví v nastavení fotoaparátu.</string>
    <string name="desc_camera_jpeg_100">Ukládá JPEG fotografie s kvalitou 100 % a vypíná dodatečnou kompresi.</string>

    <!-- Displej -->
    <string name="title_display_outdoor">Venkovní režim</string>
    <string name="desc_display_outdoor">Zpřístupní přepínač Venkovní režim v Nastavení &gt; Displej. Režim se zapíná tam, ne zde.</string>
    <string name="title_display_screen_mode">Profily displeje</string>
    <string name="desc_display_screen_mode">Odemkne profesionální profily AMOLED Cinema (DCI-P3) a AMOLED Photo (Adobe RGB).</string>
    <string name="row_active_profile">Aktivní profil</string>
    <string name="title_display_screen_timeout">Screen timeouty</string>
    <string name="desc_display_screen_timeout">Odemkne 30 minut, 1 hodinu a možnost Nikdy v nabídce vypnutí obrazovky.</string>
    <string name="row_screen_timeout">Vypnutí obrazovky</string>
    <string name="title_display_action_timeout">Čas pro provedení akce</string>
    <string name="desc_display_action_timeout">Nastaví dobu, po kterou systém čeká na potvrzení akce u asistivních funkcí.</string>
    <string name="row_action_timeout">Doba čekání</string>
    <string name="title_display_ead">Adaptivní barevný tón (EAD)</string>
    <string name="desc_display_ead">Vynutí podporu adaptivního barevného tónu displeje v Nastavení.</string>
    <string name="title_display_fonts">Odemčení fontů</string>
    <string name="desc_display_fonts">Povolí instalaci a použití vlastních systémových fontů bez kontroly podpisu.</string>

    <!-- Systém -->
    <string name="title_call_recording">Nahrávání hovorů</string>
    <string name="desc_call_recording">Aktivuje nativní tlačítko nahrávání hovorů v aplikaci Telefon.</string>
    <string name="title_wifi_passwords">Zobrazení hesel</string>
    <string name="desc_wifi_passwords">Zobrazí uložená hesla Wi-Fi bez ověření zámku obrazovky.</string>
    <string name="title_flag_secure">Obejití screenshotu</string>
    <string name="desc_flag_secure">Povolí snímky obrazovky i v aplikacích chráněných příznakem FLAG_SECURE.</string>
    <string name="title_telemetry">Zakázání telemetrie</string>
    <string name="desc_telemetry">Vypne odesílání crash logů a systémových diagnostických záznamů.</string>

